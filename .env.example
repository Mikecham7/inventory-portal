GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot-name@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Optional encrypted store-token storage. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set the same key on every API instance; keep it in your secret manager, not Google Sheets.
# Back up securely. Changing/removing it makes existing encrypted tokens unreadable.
STORE_INTEGRATION_KEY=
